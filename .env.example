# /var/www/wyrdane-backend/.env
# Utilisé par docker-compose.yml (docker compose lit automatiquement ce fichier
# s'il est à côté du docker-compose.yml)
# NE JAMAIS committer une fois rempli. chmod 600 .env

FRONTEND_URL=https://wyrdane.com
BACKEND_URL=https://api.wyrdane.com

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_MOI_ROOT
DB_NAME=wyrdane
DB_USER=wyrdane_app
DB_PASSWORD=CHANGE_MOI_APP

# Backend
# Générer avec: openssl rand -hex 64
# NE JAMAIS réutiliser le secret de Render.
TOKEN_SECRET=CHANGE_MOI

STEAM_WEB_API_KEY=CHANGE_MOI
# 480 = AppID de test public (Spacewar). Suffisant pour vérifier un ticket avec
# une clé Web API personnelle, mais ne prouve NI la possession du jeu NI la
# provenance du ticket : voir l'en-tête de src/helper/steamHelper.ts. À
# remplacer par 5052390 dès qu'une clé Publisher Steamworks est disponible
# (l'API journalise un avertissement au démarrage tant que c'est 480 en prod).
STEAM_APP_ID=480

# Tickets joués via le partage familial Steam (ownersteamid != steamid). Refusés
# par défaut : une licence partagée permet de multiplier les comptes depuis un
# seul achat (farm de parrainages, collusion en classé). Mettre "true" pour les
# accepter — arbitrage produit, le partage familial reste une fonctionnalité
# légitime de Steam. Sans effet tant que STEAM_APP_ID vaut 480.
ALLOW_STEAM_FAMILY_SHARING=false

# Webhook entrant Discord (salon dev) : Paramètres du salon > Intégrations >
# Webhooks > Nouveau webhook > Copier l'URL. Optionnel : si absente, les
# rapports de crash/gel sont simplement ignorés côté notification (soft no-op).
DISCORD_CRASH_WEBHOOK_URL=

# Sauvegardes de la base (scripts/backup-db.sh, lancé par cron sur le VPS).
# BACKUP_DIR : où écrire les dumps (défaut /var/backups/wyrdane).
# BACKUP_REMOTE : destination rsync/ssh d'une copie HORS du VPS — sans elle, les
# sauvegardes ne survivent pas à la perte de la machine qu'elles protègent.
BACKUP_DIR=/var/backups/wyrdane
BACKUP_REMOTE=
