# /var/www/wyrdane-backend/.env
# Utilisé par docker-compose.yml (docker compose lit automatiquement ce fichier
# s'il est à côté du docker-compose.yml)
# NE JAMAIS committer une fois rempli. chmod 600 .env

FRONTEND_URL=https://wyrdane.com
BACKEND_URL=https://api.wyrdane.com

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_MOI_ROOT
DB_NAME=wyrdane
DB_USER=wyrdane_app
DB_PASSWORD=CHANGE_MOI_APP

# Backend
# Générer avec: openssl rand -hex 64
# NE JAMAIS réutiliser le secret de Render.
TOKEN_SECRET=CHANGE_MOI

STEAM_WEB_API_KEY=CHANGE_MOI
# 480 = AppID de test public (Spacewar). Suffisant pour vérifier un ticket avec
# une clé Web API personnelle, mais ne prouve NI la possession du jeu NI la
# provenance du ticket : voir l'en-tête de src/helper/steamHelper.ts. À
# remplacer par 5052390 dès qu'une clé Publisher Steamworks est disponible
# (l'API journalise un avertissement au démarrage tant que c'est 480 en prod).
STEAM_APP_ID=480

# Tickets joués via le partage familial Steam (ownersteamid != steamid). Refusés
# par défaut : une licence partagée permet de multiplier les comptes depuis un
# seul achat (farm de parrainages, collusion en classé). Mettre "true" pour les
# accepter — arbitrage produit, le partage familial reste une fonctionnalité
# légitime de Steam. Sans effet tant que STEAM_APP_ID vaut 480.
ALLOW_STEAM_FAMILY_SHARING=false

# Webhook entrant Discord (salon dev) : Paramètres du salon > Intégrations >
# Webhooks > Nouveau webhook > Copier l'URL. Optionnel : si absente, les
# rapports de crash/gel sont simplement ignorés côté notification (soft no-op).
DISCORD_CRASH_WEBHOOK_URL=

# Sauvegardes de la base (scripts/backup-db.sh, lancé par cron sur le VPS).
# BACKUP_DIR : où écrire les dumps.
#   ⚠ Le défaut du script (/var/backups/wyrdane) exige root : le compte `deploy`
#   qui porte le cron ne peut pas y créer de dossier, et le script échouait sur
#   `mkdir: Permission denied` (constaté le 2026-11-12, aucune sauvegarde n'avait
#   donc jamais été produite). Pointer vers un dossier que `deploy` possède, et
#   surtout HORS de /var/www/wyrdane-backend : un dump qui vit dans le répertoire
#   de l'application disparaît avec elle au prochain redéploiement.
# BACKUP_REMOTE : destination rsync/ssh d'une copie HORS du VPS, POUSSÉE depuis
#   ici. ⚠ Ne la renseigner que pour une destination joignable en permanence :
#   une machine intermittente (un PC de bureau) fait échouer la copie et
#   déclenche une alerte Discord chaque nuit où elle est éteinte, ce qui apprend
#   à ignorer ces alertes. Pour un PC, préférer l'inverse — le PC TIRE les dumps
#   quand il tourne, et cette variable reste vide (choix retenu le 2026-11-12,
#   voir docs/beta-launch-runbook.md côté card-game).
BACKUP_DIR=/home/deploy/backups/wyrdane
BACKUP_REMOTE=

# HEALTHCHECK_URL : « dead man's switch » de la sauvegarde. L'alerte Discord
# ci-dessus ne part que si le script TOURNE et échoue ; si le VPS est mort, rien
# ne tourne donc rien n'alerte, et le silence devient indiscernable de « tout va
# bien ». Un surveillant installé sur le VPS mourrait avec lui : celui-ci est
# dehors, et c'est l'ABSENCE de ping avant l'échéance qui déclenche son alerte.
# Un seul mécanisme couvre donc sauvegarde cassée en silence ET machine
# disparue. Créer un check sur healthchecks.io (offre gratuite suffisante) et
# coller son URL de ping ici. Vide = pas de ping, aucune conséquence.
# À compléter par un moniteur de disponibilité externe sur https://api.wyrdane.com/
# (UptimeRobot, Better Stack…), qui lui prévient en minutes plutôt qu'à
# l'échéance de la sauvegarde.
HEALTHCHECK_URL=

# HEALTH_KEY : secret partage qui ouvre le niveau DETAILLE de GET /api/health.
# Sans en-tete `x-health-key`, la route ne renvoie que ce dont un moniteur de
# disponibilite a besoin (service debout, base joignable) — c'est public et
# c'est voulu. Avec la bonne cle, elle ajoute la fraicheur de la derniere
# sauvegarde : « les sauvegardes sont mortes depuis 5 jours » est precisement
# le genre d'information qui renseigne qui ne devrait pas. Renseigner la meme
# valeur ici et dans le .env du bot Discord (commande /status).
# Vide = le niveau detaille reste ferme a tout le monde.
HEALTH_KEY=
